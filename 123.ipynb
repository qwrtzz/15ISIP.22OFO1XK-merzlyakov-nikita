"13. Напишите код, который преобразует температуру из градусов Цельсия в Фаренгейты и наоборот, используя формулы конвертации."
]
},
{
"cell_type": "code",
"execution_count": null,
"metadata": {},
"outputs": [],
"source": [
"temp = float(input("Введите температуру: "))\n",
"scale = input("Введите шкалу (C/F): ").upper()\n",
"if scale == 'C':\n",
" print(f"{temp}°C = {temp * 9/5 + 32}°F")\n",
"elif scale == 'F':\n",
" print(f"{temp}°F = {(temp - 32) * 5/9}°C")\n",
"else:\n",
" print("Ошибка ввода шкалы")"
]
},
